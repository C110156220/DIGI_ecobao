# ─────────────────────────────────────────────────────────────
# 環飽 EcoBǎo — Backend environment variables (example)
# 複製本檔為 .env 並填入實際值；請勿將 .env 提交至版本控制。
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Django core
# 產生方式 / generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-50-char-secret
DEBUG=True
# 逗號分隔 / comma-separated (production 請勿使用 *)
ALLOWED_HOSTS=*

# Database (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=ecobao
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS — 逗號分隔的允許來源 / comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8000,http://localhost:3000

# Email (Gmail SMTP) — 用於訂單通知信 / used for order notification emails
# EMAIL_HOST_PASSWORD 請使用 Gmail「應用程式密碼」 (App Password)
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Google Maps Geocoding API — 店家地址轉經緯度 / store address geocoding
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
